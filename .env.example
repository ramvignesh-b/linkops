# Copy to `.env` (gitignored) to override these defaults. Optional — see
# the README's "Configuration" section.

# Port the API listens on.
API_PORT=3000

# Mounts the interactive Swagger explorer at GET /api.
SWAGGER_UI_ENABLED=false

# "stub" (default, no key needed), "gemini" (needs a key), or "anthropic"
# (unshipped — a boot failure).
ASSISTANT_PROVIDER=stub

# Required only when ASSISTANT_PROVIDER=gemini or ASSISTANT_PROVIDER=anthropic.
ASSISTANT_PROVIDER_KEY=dummy-key-do-not-use

# Gemini model identifier (defaults to gemini-3.7-flash).
ASSISTANT_MODEL=gemini-3.7-flash
