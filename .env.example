# Copy to `.env` (gitignored) to override the defaults below for local
# development. Every row here carries a placeholder value — never a real
# key — and none of this file is required: with no `.env` at all, the
# application starts and the Assistant answers through the stub, with no
# credentials anywhere.
#
# Boot validates these four variables for coherence, not presence — see
# the "Configuration" section of the README — and fails fast, naming
# whichever variable is wrong, rather than starting in a state nobody
# asked for.

# The port the API listens on.
PORT=3000

# Mounts the interactive Swagger explorer at GET /api. Off by default: an
# unauthenticated, DELETE-capable explorer is a different proposition on a
# host managing live radio infrastructure than on a developer's laptop.
# GET /api/openapi.json is served either way.
SWAGGER_UI_ENABLED=false

# "stub" (default) needs no key and ships in this repository. "model"
# selects a real model provider — the seam exists, but no client for it
# ships here, so choosing it is a boot failure, not a silent downgrade
# back to the stub.
ASSISTANT_PROVIDER=stub

# Required only when ASSISTANT_PROVIDER=model. Never logged, never sent to
# the Console, and this placeholder is not a real key.
ASSISTANT_PROVIDER_KEY=dummy-key-do-not-use
