# Copy to `.env` (gitignored) to override these defaults. Optional — see
# the README's "Configuration" section.

# Port the API listens on.
PORT=3000

# Mounts the interactive Swagger explorer at GET /api.
SWAGGER_UI_ENABLED=false

# "stub" (default, no key needed) or "model" (unshipped — a boot failure).
ASSISTANT_PROVIDER=stub

# Required only when ASSISTANT_PROVIDER=model.
ASSISTANT_PROVIDER_KEY=dummy-key-do-not-use
