# syntax=docker/dockerfile:1

# ─────────────────────────────────────────────────────────────────────────────
# Stage 1: Base Node.js environment
# ─────────────────────────────────────────────────────────────────────────────
FROM node:24-alpine AS base
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@11.21.0 --activate
WORKDIR /app

# ─────────────────────────────────────────────────────────────────────────────
# Stage 2: Dependencies and Console Build
# ─────────────────────────────────────────────────────────────────────────────
FROM base AS builder

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .nvmrc ./
RUN pnpm install --frozen-lockfile

COPY nx.json tsconfig.base.json ./
COPY apps/ ./apps/
COPY libs/ ./libs/

RUN pnpm nx run-many -t build -p console assistant

# ─────────────────────────────────────────────────────────────────────────────
# Stage 3: Console Nginx Runtime
# ─────────────────────────────────────────────────────────────────────────────
FROM nginx:alpine AS runner
ENV API_URL=http://api:3000/api/

COPY deploy/nginx/nginx.conf /etc/nginx/nginx.conf
COPY deploy/nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist/apps/console/browser /usr/share/nginx/html
COPY --from=builder /app/dist/apps/assistant/browser /usr/share/nginx/html/assistant

EXPOSE 80

HEALTHCHECK --interval=5s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
